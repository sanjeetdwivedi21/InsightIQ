# LLM provider: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=

# Databases
BUSINESS_DB_PATH=data/processed/insightiq_business.db
APP_DB_PATH=data/processed/insightiq_app.db

# Safety limits
SQL_ROW_LIMIT=1000
SQL_TIMEOUT_SECONDS=10

# Logging
LOG_LEVEL=INFO